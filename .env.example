# ---------------------------------------------------------------------------
# Rentless — environment variables
# Copy to `.env.local` and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for metadata, invite links, receipt links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Locale / currency defaults
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Set to "true" only after Twilio is configured in Supabase (Auth → Providers → Phone)
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false

# Reminder emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=reminders@yourdomain.com

# Shared secret guarding /api/reminders and the send-reminders edge function
CRON_SECRET=

# Phone OTP (Twilio) is configured in the Supabase dashboard, not here:
#   Authentication → Providers → Phone → Twilio
#   SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN / _ACCOUNT_SID / _MESSAGE_SERVICE_SID
